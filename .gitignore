# ==============================================================================
# TrackPal Monorepo .gitignore
# Covers Web (Vite / TanStack Start / React) & Server (Laravel / PHP)
# ==============================================================================

# --- Operating System & Common Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# --- IDE & Editor Configurations ---
.idea/
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.nova/
.zed/
.fleet/
*.sublime-project
*.sublime-workspace
.phpactor.json
.cursor/
.cursorrules.local
/.codex

# --- Environment & Secrets ---
.env
.env.*
!.env.example
*.local
auth.json

# --- Logs & Runtime ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==============================================================================
# Frontend (web/) - Vite, TanStack Start, React 19, TypeScript
# ==============================================================================
node_modules/
web/node_modules/
.pnpm-store/

# Build outputs
dist/
dist-ssr/
web/dist/
web/dist-ssr/
.output/
web/.output/
.nitro/
web/.nitro/
.vinxi/
web/.vinxi/
.tanstack/
web/.tanstack/
.wrangler/
web/.wrangler/

# Cache & Diagnostics
.turbo/
.cache/
.eslintcache
.stylelintcache
__unconfig*
web/__unconfig*
todos.json
web/todos.json

# ==============================================================================
# Backend (server/) - Laravel 13, Composer, PHP
# ==============================================================================
server/vendor/
server/node_modules/
server/.phpunit.cache
server/.phpunit.result.cache
server/.env
server/.env.backup
server/.env.production
server/.env.testing

# Laravel compiled and generated public assets
server/public/build
server/public/hot
server/public/storage
server/public/fonts-manifest.dev.json

# Laravel storage directories
server/storage/*.key
server/storage/pail
server/storage/logs/*.log
server/storage/framework/cache/data/*
!server/storage/framework/cache/data/.gitignore
server/storage/framework/sessions/*
!server/storage/framework/sessions/.gitignore
server/storage/framework/views/*
!server/storage/framework/views/.gitignore
server/storage/framework/testing/*
!server/storage/framework/testing/.gitignore

# Development / Tooling helpers
server/_ide_helper.php
server/_ide_helper_models.php
server/.phpstorm.meta.php
server/Homestead.json
server/Homestead.yaml

# Testing & Coverage
coverage/
*.lcov
.nyc_output
